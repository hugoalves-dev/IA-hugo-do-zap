# Compose reads this file only for interpolation; individual services receive explicit variables.
# Copy to .env; only watcher and Evolution API are started with the default prod profile.
COMPOSE_PROFILES=prod
WATCHER_IMAGE=ghcr.io/hugoalves-dev/ia-hugo-do-zap:latest
TZ=America/Sao_Paulo
WATCHER_TIMEZONE=America/Sao_Paulo

# Dedicated database and role in the existing PostgreSQL service. Do not reuse Evolution's role.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.example.internal:5432/watcher
SPRING_DATASOURCE_USERNAME=watcher_app
SPRING_DATASOURCE_PASSWORD=replace-with-watcher-password
EVOLUTION_DATABASE_URL=postgresql://evolution_app:replace-with-evolution-password@postgres.example.internal:5432/evolution

WATCHER_TELEGRAM_BOT_TOKEN=replace-with-token-from-BotFather
WATCHER_TELEGRAM_CHAT_ID=123456789
WATCHER_EVOLUTION_WEBHOOK_TOKEN=replace-with-a-distinct-long-random-token
WATCHER_EVOLUTION_INSTANCE=watcher-evolution

# Shadow simulation is independent from real actions. Database admin settings can
# further pause per-chat processing; disabling shadow does not enable production.
WATCHER_SIMULATION_ENABLED=true
WATCHER_DECISION_PRODUCER_REAL_MODE_ENABLED=false
WATCHER_WHATSAPP_ACTIONS_REAL_SEND_ENABLED=false
WATCHER_WHATSAPP_ACTIONS_EVOLUTION_ENABLED=false
WATCHER_WHATSAPP_ACTIONS_EVOLUTION_BASE_URL=https://evolution.example.invalid
WATCHER_WHATSAPP_ACTIONS_EVOLUTION_INSTANCE=watcher-evolution
WATCHER_WHATSAPP_ACTIONS_EVOLUTION_API_KEY=replace-with-evolution-api-key

# OpenRouter is primary; Google AI Studio / Gemini is an optional technical-failure fallback.
# Both providers require separate per-chat consent. Keep AI off until consent, gates and budgets are configured.
WATCHER_AI_ENABLED=false
WATCHER_AI_GEMINIAPIKEY=
WATCHER_AI_GEMINIMODEL=
WATCHER_AI_OPENROUTERAPIKEY=
WATCHER_AI_OPENROUTERMODEL=
WATCHER_AI_ATTEMPTHOLDMICROS=0
WATCHER_AI_TIMEOUT=15s

EVOLUTION_API_KEY=replace-with-a-distinct-evolution-api-key
EVOLUTION_SERVER_URL=http://evolution-api:8080
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7@sha256:1bd8afc4a6cf48822e6cf02469aeae7bd35a12a6b616eacd1291926307f4d339
EVOLUTION_HOST_PORT=8080

# Optional local PostgreSQL profile; create a private copy of this file first.
# Use distinct generated passwords and point the two application URLs at these
# service names in that local copy. Never enable this profile on the VPS.
LOCAL_POSTGRES_IMAGE=postgres:17.11-alpine3.23@sha256:01ea903aa65deb58eb49d6e09d859ecff63a6bb7d61feca55f2abad71d08f72a
LOCAL_WATCHER_DB_NAME=watcher
LOCAL_WATCHER_DB_USER=watcher_local
LOCAL_WATCHER_DB_PASSWORD=replace-with-local-watcher-password
LOCAL_EVOLUTION_DB_NAME=evolution
LOCAL_EVOLUTION_DB_USER=evolution_local
LOCAL_EVOLUTION_DB_PASSWORD=replace-with-local-evolution-password

WATCHER_NOTIFICATION_DAYS=1,2,3,4,5
WATCHER_NOTIFICATION_WINDOWS_0_START=08:00
WATCHER_NOTIFICATION_WINDOWS_0_END=12:00
WATCHER_NOTIFICATION_WINDOWS_1_START=13:30
WATCHER_NOTIFICATION_WINDOWS_1_END=17:30
WATCHER_ALLOWED_NAME_REGEX=(^|[^A-Z0-9])JC([^A-Z0-9]|$)
WATCHER_INCLUDE_GROUPS=true
WATCHER_NEVER_NOTIFY_GROUP_NAMES_0=233/234
WATCHER_MAX_BATCH_SIZE=50
WATCHER_RETENTION_DAYS=7
