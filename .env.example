# Compose reads this file only for interpolation; individual services receive explicit variables.
TZ=America/Sao_Paulo
WATCHER_TIMEZONE=America/Sao_Paulo

# Dedicated database and role in the existing PostgreSQL service. Do not reuse Evolution's role.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres.example.internal:5432/watcher
SPRING_DATASOURCE_USERNAME=watcher_app
SPRING_DATASOURCE_PASSWORD=replace-with-watcher-password
EVOLUTION_DATABASE_URL=postgresql://evolution_app:replace-with-evolution-password@postgres.example.internal:5432/evolution

WATCHER_N8N_URL=https://n8n.example.com/webhook/watcher
WATCHER_N8N_SECRET=replace-with-n8n-secret
WATCHER_EVOLUTION_WEBHOOK_TOKEN=replace-with-a-distinct-long-random-token
WATCHER_EVOLUTION_INSTANCE=watcher-evolution

EVOLUTION_API_KEY=replace-with-a-distinct-evolution-api-key
EVOLUTION_SERVER_URL=http://evolution-api:8080
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7@sha256:1bd8afc4a6cf48822e6cf02469aeae7bd35a12a6b616eacd1291926307f4d339
REDIS_IMAGE=redis:7.4.2-alpine@sha256:02419de7eddf55aa5bcf49efb74e88fa8d931b4d77c07eff8a6b2144472b6952

WATCHER_NOTIFICATION_DAYS=1,2,3,4,5
WATCHER_NOTIFICATION_WINDOWS_0_START=08:00
WATCHER_NOTIFICATION_WINDOWS_0_END=12:00
WATCHER_NOTIFICATION_WINDOWS_1_START=13:30
WATCHER_NOTIFICATION_WINDOWS_1_END=17:30
WATCHER_ALLOWED_NAME_REGEX=(^|[^A-Z0-9])JC([^A-Z0-9]|$)
WATCHER_INCLUDE_GROUPS=true
WATCHER_NEVER_NOTIFY_GROUP_NAMES_0=233/234
WATCHER_MAX_BATCH_SIZE=50
WATCHER_RETENTION_DAYS=7
